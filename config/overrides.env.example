# 在官方 .env.example 基础上需要改动的配置项。
# scripts/install.sh 与 scripts/restore.sh 会把本文件中的 KEY=VALUE 写入 WeKnora 目录下的 .env。
# 本文件不含密钥：JWT_SECRET、SYSTEM_AES_KEY 由 install.sh 自动生成，只保存在 .env 中。

# 镜像版本：与克隆的 WeKnora git tag 保持一致（注意 v 前缀）。
# 升级 WeKnora 后同步修改此处，否则迁移时会按旧版本恢复。
WEKNORA_VERSION=v0.8.2

# 端口监听地址：默认仅本机可访问。
# 云服务器需要公司同事访问时改为 FRONTEND_PORT=80、APP_PORT=8080，
# 并在安全组中只放行公司出口 IP（或通过 VPN 访问）。
FRONTEND_PORT=127.0.0.1:80
APP_PORT=127.0.0.1:8080

# Ollama 地址（容器内访问宿主机上的 Ollama）。
OLLAMA_BASE_URL=http://host.docker.internal:11434
